rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email == 'jittokofficial@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if admin() || resource.data.status in ['published', 'sold-out'];
      allow create, update, delete: if admin();
    }
    match /siteContent/home {
      allow read: if true;
      allow write: if admin();
    }
    // Requests submitted through the existing WhatsApp flow are unverified
    // enquiries. They must never be used as proof of payment or revenue.
    match /orders/{orderId} {
      allow read, update, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly([
          'orderReference', 'items', 'subtotal', 'shipping', 'total',
          'customerName', 'customerPhone', 'deliveryAddress', 'pincode',
          'status', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'orderReference', 'items', 'subtotal', 'shipping', 'total',
          'status', 'source', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderReference is string
        && request.resource.data.orderReference.size() <= 80
        && request.resource.data.status == 'new'
        && request.resource.data.source in ['cart', 'product-page']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.shipping is number
        && request.resource.data.shipping >= 0
        && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shipping
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
